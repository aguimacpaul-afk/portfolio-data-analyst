"""Ejercicio: Ventas y fidelización

Tienes una tabla orders con las columnas:
	customer_id
	order_id
	order_date
	total_amount

Tienes otra tabla customers con:
	customer_id
	signup_date
	loyalty_status (Active / Inactive)

Reto:

	Calcula el ticket promedio (monto promedio de compra) por cliente.
	Agrupa a los clientes por loyalty_status y compara sus tickets promedio.
	Visualiza con un gráfico de violín o boxplot para mostrar la dispersión de gastos entre Active e Inactive.
	Redacta una breve conclusión/storyline de los hallazgos."""

orders = df_rest[['customer_id','order_id','order_date']].copy() #total_amount
customers = df_rest[['customer_id', 'signup_date','churned']] #loyalty_activity
orders['total_amount'] = df_rest.price * df_rest.quantity

ticket_media = orders.groupby('customer_id')['total_amount'].mean().sort_values().reset_index()
ticket_media.columns=['customer_id','media_spent']
"""  customer_id  media_spent
0       C6699       101.73
1       C5239       102.75
2       C3252       104.08
3       C1422       106.31
4       C5322       106.70"""
churn_media = pd.merge(ticket_media, customers, on = 'customer_id', how='inner')

plt.figure(num='Amount vs Churned', figsize=(10,6))
sns.boxplot(data=churn_media, x='churned', y='media_spent')
plt.xlabel("Activity")
plt.ylabel("media spent")
plt.show()

