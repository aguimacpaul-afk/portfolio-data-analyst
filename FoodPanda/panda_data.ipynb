# 2 Ciudades con más churn: Encuentra qué ciudad tiene más clientes Inactivos (churned = 'Inactive') y su porcentaje
# sobre el total de esa ciudad.
"""           city   churned
0      Peshawar    Active
1        Multan    Active
2        Multan  Inactive
3      Peshawar  Inactive
4        Lahore  Inactive"""

total_city = df_rest.city.value_counts().reset_index()
total_city.columns = ['city','population']
"""		city  population
3  Islamabad        1187
4    Karachi        1145
1     Lahore        1217
0     Multan        1256
2   Peshawar        1195""
"""
churned_city = pd.crosstab(df_rest["city"], df_rest["churned"])
"""churned    Active  Inactive
city                       
Islamabad     602       585
Karachi       597       548
Lahore        586       631
Multan        608       648
Peshawar      623       572"""
churned_city = pd.merge(total_city, churned_city, on='city', how='inner')
"""        city  population  Active  Inactive
0     Multan        1256     608       648
1     Lahore        1217     586       631
2   Peshawar        1195     623       572
3  Islamabad        1187     602       585
4    Karachi        1145     597       548
"""
churned_city['inactive_%'] = (churned_city.Inactive * 100 / churned_city.population).round(2)
