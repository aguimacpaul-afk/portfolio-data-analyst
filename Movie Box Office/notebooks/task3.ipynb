#Tarea 3 – Tendencias y correlaciones (EDA avanzada)

df_corr = df[['BudgetUSD','Global_BoxOfficeUSD','US_BoxOfficeUSD','IMDbRating','RottenTomatoesScore']]
corr =df_corr.corr()

plt.figure(num="Correlaciones entre presupuesto, taquilla y ratings",figsize=(8,5))
sns.heatmap(corr, annot=True, cmap="coolwarm",fmt=".2f")
plt.title("Correlaciones entre presupuesto, taquilla y ratings")
#plt.show()

release_trend = df.groupby("ReleaseYear").size().reset_index(name="NumMovies")
# Línea de tendencia
plt.figure(num="Número de estrenos por año",figsize=(10,5))
sns.lineplot(data=release_trend, x="ReleaseYear", y="NumMovies")
plt.title("Número de estrenos por año")
plt.xlabel("Año de estreno")
plt.ylabel("Número de películas")
#plt.show()

# Calculamos el promedio global por género
avg_revenue = df.groupby("Genre")["Global_BoxOfficeUSD"].mean().reset_index()

# Ordenamos de mayor a menor
avg_revenue = avg_revenue.sort_values("Global_BoxOfficeUSD", ascending=False)

# Gráfico de barras
plt.figure(figsize=(10,5))
sns.barplot(data=avg_revenue, x="Genre", y="Global_BoxOfficeUSD", palette="viridis")
plt.title("Ingresos globales promedio por género")
plt.ylabel("Global Box Office (USD)")
plt.xticks(rotation=45)
#plt.show()
