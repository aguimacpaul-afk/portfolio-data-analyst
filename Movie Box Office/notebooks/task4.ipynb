# Tarea 4 – KPI para negocio

"""'MovieID', 'Title', 'Genre', 'ReleaseYear', 'ReleaseDate', 'Country',
       'BudgetUSD', 'US_BoxOfficeUSD', 'Global_BoxOfficeUSD',
       'Opening_Day_SalesUSD', 'One_Week_SalesUSD', 'IMDbRating',
       'RottenTomatoesScore', 'NumVotesIMDb', 'NumVotesRT', 'Director',
       'LeadActor']"""

total_globalbox = df.groupby("MovieID")['Global_BoxOfficeUSD'].sum().reset_index()
total_globalbox['Global_BoxOfficeUSD-M'] = total_globalbox.Global_BoxOfficeUSD/1_000_000
#print(total_globalbox[['MovieID','Global_BoxOfficeUSD-M']].head())
"""   MovieID  Global_BoxOfficeUSD-M
0        1              15.472036
1        2               3.637731
2        3               7.165111
3        4               4.373820
4        5               3.113017"""


df['Global_BoxOfficeUSD-M'] = total_globalbox['Global_BoxOfficeUSD-M'].copy()

df['venta por usuario'] = (df.US_BoxOfficeUSD / df.NumVotesIMDb).round(2)
#print(df[['MovieID','venta por usuario']].head())
"""   MovieID  venta por usuario
0        1             840.90
1        2            1130.53
2        3             894.98
3        4             820.30
4        5             383.37"""

top_director = df.groupby('Director')['Global_BoxOfficeUSD-M'].sum().round(2).reset_index().head(10)
top_director = top_director.sort_values('Global_BoxOfficeUSD-M', ascending=False)
#print(top_director.head(10))
"""
            Director  Global_BoxOfficeUSD-M
82       Judy Walker              194740.42
3    Albert Phillips              194476.11
51      Emily Miller              193126.37
149   William Walker              192378.46
19    Brooke Morales              191935.44
45     Diane Skinner              191766.03
134    Sharon Wilson              191278.79
77    Jonathan Evans              191099.77
1         Adam Brown              190861.36
90       Kim Watkins              190566.78"""

venta_genero = (
    df.groupby("Genre", as_index=False)['venta por usuario']
      .mean()
      .sort_values('venta por usuario', ascending=False)
) 

# --- Subplot ---
fig, axs = plt.subplots(1, 2, figsize=(15, 6))

# Gráfico 1: Top Directores
sns.barplot(
    data=top_director,
    y="Director",
    x="Global_BoxOfficeUSD-M",
    palette="Blues_r",
    ax=axs[0]
)
axs[0].set_title("Top 10 Directores por Ingresos Globales (M USD)", fontsize=12)
axs[0].set_xlabel("Ingresos Globales (Millones USD)")
axs[0].set_ylabel("Director")

# Gráfico 2: Venta por Usuario Promedio por Género
sns.barplot(data=venta_genero,
    x="Genre",
    y="venta por usuario",
    palette="viridis",
    ax=axs[1]
)
axs[1].set_title("Venta por Usuario Promedio por Género", fontsize=12)
axs[1].set_xlabel("Género")
axs[1].set_ylabel("Venta por Usuario (USD)")
axs[1].tick_params(axis='x', rotation=45)

plt.tight_layout()
