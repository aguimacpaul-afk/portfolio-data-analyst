def data_quality_report(df):
    report = pd.DataFrame({
        "Tipo de dato": df.dtypes,
        "Valores únicos": df.nunique(),
        "Nulos (%)": df.isnull().mean() * 100,
        "Duplicados": [df[col].duplicated().sum() for col in df.columns]
    })
    
    # Observaciones personalizadas
    observaciones = []
    for col in df.columns:
        if df[col].dtype in ["int64", "float64"]:
            min_val = df[col].min()
            max_val = df[col].max()
            observaciones.append(f"Rango: {min_val} – {max_val}")
        else:
            top_vals = df[col].value_counts().head(2).index.tolist()
            observaciones.append(f"Más comunes: {top_vals}")
    
    report["Observaciones"] = observaciones
    return report

# Generar tabla de calidad de datos
quality_table = data_quality_report(df)
