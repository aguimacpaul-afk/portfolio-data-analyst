#Tarea 5 – Machine Learning (intro)

from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeRegressor
from sklearn.metrics import mean_absolute_error
from sklearn.preprocessing import OneHotEncoder
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline

# Features
y = df['Global_BoxOfficeUSD']
X = df[['BudgetUSD','Genre', 'IMDbRating', 'RottenTomatoesScore']]

# Columnas categóricas y numéricas
categorical = ['Genre']
numerical = ['BudgetUSD', 'IMDbRating', 'RottenTomatoesScore']

# Preprocesador: One-Hot para categóricas
preprocessor = ColumnTransformer(
    transformers=[
        ('cat', OneHotEncoder(handle_unknown='ignore'), categorical),
        ('num', 'passthrough', numerical)
    ]
)

# Modelo
model = DecisionTreeRegressor(random_state=42)

# Pipeline (preprocesamiento + modelo)
clf = Pipeline(steps=[('preprocessor', preprocessor),
                     ('model', model)])

# Train/Test Split
train_X, val_X, train_y, val_y = train_test_split(X, y, random_state=42)

# Entrenamiento
clf.fit(train_X, train_y)

# Predicciones
preds_val = clf.predict(val_X)

# Evaluación
mae = mean_absolute_error(val_y, preds_val)
print("MAE:", mae)

from sklearn.metrics import r2_score, mean_squared_error
import numpy as np
import matplotlib.pyplot as plt

# --- Evaluación ---
r2 = r2_score(val_y, preds_val)
rmse = np.sqrt(mean_squared_error(val_y, preds_val))

print(f"R²: {r2:.3f}")
print(f"RMSE: {rmse:,.0f} USD")

# --- Gráfico: valores reales vs predichos ---
plt.figure(figsize=(6,6))
plt.scatter(val_y, preds_val, alpha=0.5, color='teal')
plt.plot([val_y.min(), val_y.max()], [val_y.min(), val_y.max()], 'r--', lw=2)
plt.xlabel("Valores Reales (USD)")
plt.ylabel("Valores Predichos (USD)")
plt.title("Comparación: Reales vs Predichos")
plt.show()




