#diferencia promedio de charges entre fumadores y no fumadores.
charges_smoker = df.groupby('smoker')['charges'].mean().round(2).reset_index()
"""smoker   charges
0     no   8434.27
1    yes  32050.23"""

dif_smoker = abs(charges_smoker.loc[0,'charges']-charges_smoker.loc[1,'charges'])
print(dif_smoker) #23615.96

#Normaliza bmi con min-max scaling (sin usar sklearn, solo numpy).

bmi = df['bmi'].values

bmi_min = np.min(bmi)
bmi_max = np.max(bmi)

bmi_z = (bmi-bmi_min)/(bmi_max-bmi_min)

df['bmi_scaled'] = bmi_z
"""      bmi  bmi_scaled
0  27.900    0.321227
1  33.770    0.479150
2  33.000    0.458434
3  22.705    0.181464
4  28.880    0.347592"""

"""Crea una nueva columna categórica:
bmi_category: Bajo peso (<18.5), Normal (18.5–24.9), 
Sobrepeso (25–29.9), Obeso (>=30)."""

conditions=[
   (df.bmi < 18.5),
   (df.bmi <= 24.9) & (df.bmi >=18.5),
   (df.bmi <= 29.9) & (df.bmi >=25),
   (df.bmi >=30),
]
categories=['Bajo peso', 'Normal', 'Sobrepeso', 'Obeso']

df['bmi_category'] = np.select(conditions,categories)
"""0    Sobrepeso
1        Obeso
2        Obeso
3       Normal
4    Sobrepeso"""

#scatter bmi vs charges vs smoker
plt.figure(num='bmi vs charges', figsize=(12,6))
sns.scatterplot(x='bmi', y='charges', hue='smoker', data=df, alpha=0.6)
sns.regplot(x='bmi', y='charges', data=df, scatter=False, color="black")
#plt.show()

# 3 ML
#Usa LinearRegression (de sklearn) para predecir charges a partir de: age, bmi, children y smoker.
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, r2_score
from sklearn.tree import DecisionTreeRegressor
from sklearn.model_selection import train_test_split

y = df.charges

features = ['age','bmi','children','smoker']
df['smoker'] = df['smoker'].map({'no': 0, 'yes': 1})  
X=df[features]

X_train, X_test, y_train, y_test = train_test_split(X,y,random_state=42)

# modelo 1: regression lineal
lin_model = LinearRegression()
lin_model.fit(X_train, y_train)
lin_preds = lin_model.predict(X_test)

lin_mae = mean_absolute_error(y_test, lin_preds)
lin_r2 = r2_score(y_test, lin_preds)

print(f"Regresión Lineal → MAE: {lin_mae:.2f} | R²: {lin_r2:.3f}")

# modelo 2: decissiontree

tree_model = DecisionTreeRegressor(max_leaf_nodes=50, random_state=42)
tree_model.fit(X_train,y_train)
tree_preds = tree_model.predict(X_test)

tree_mae = mean_absolute_error(y_test,tree_preds)
tree_r2 = r2_score(y_test, tree_preds)

#print(f"Decission Tree → MAE: {tree_mae:.2f} | R²: {tree_r2:.3f}")
"""Regresión Lineal → MAE: 4265.95 | R²: 0.765
Decission Tree → MAE: 2795.67 | R²: 0.798"""

#importancias de las variables

importances = tree_model.feature_importances_
features = X_train.columns

feat_importances = pd.DataFrame({
    'Feature': features,
    'Importance': importances
}).sort_values(by='Importance', ascending=False)

print(feat_importances)

plt.figure(num="Importancia de Features (Árbol de Decisión)",figsize=(6,4))
plt.barh(feat_importances['Feature'], feat_importances['Importance'], color="skyblue")
plt.xlabel("Importancia")
plt.ylabel("Variable")
plt.title("Importancia de Features (Árbol de Decisión)")
plt.gca().invert_yaxis()  # Para que la más importante quede arriba
plt.show()
