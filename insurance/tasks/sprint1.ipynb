# Sprint 1 – Análisis Exploratorio de Datos (EDA)
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

path="insurance.csv"
df = pd.read_csv(path) #(1338, 7)

# 1 ANALISIS EXPLORATORIO EDA
df.isnull().any() # nada

df.describe().round(2) # descripcion
"""           age      bmi  children   charges
count  1338.00  1338.00   1338.00   1338.00
mean     39.21    30.66      1.09  13270.42
std      14.05     6.10      1.21  12110.01
min      18.00    15.96      0.00   1121.87
25%      27.00    26.30      0.00   4740.29
50%      39.00    30.40      1.00   9382.03
75%      51.00    34.69      2.00  16639.91
max      64.00    53.13      5.00  63770.43"""

df.info() # info
"""Data columns (total 7 columns):
 #   Column    Non-Null Count  Dtype  
---  ------    --------------  -----  
 0   age       1338 non-null   int64  
 1   sex       1338 non-null   object 
 2   bmi       1338 non-null   float64
 3   children  1338 non-null   int64  
 4   smoker    1338 non-null   object 
 5   region    1338 non-null   object 
 6   charges   1338 non-null   float64"""

#histograma age, bmi y charges.
fig, axs = plt.subplots(1,3,figsize=(12,4), num="Histograma")
sns.histplot(df.age, ax=axs[0], color='skyblue')
sns.histplot(df.bmi, ax=axs[1], color='salmon')
sns.histplot(df.charges, ax=axs[2],color='green')
plt.tight_layout()

#Haz un boxplot para comparar charges entre fumadores y no fumadores.

plt.figure(num="Smokers vs No Smokers")
sns.boxplot(data=df, x='smoker', y='charges', palette="Set2")
plt.show()

#Calcula la matriz de correlación numérica (age, bmi, children, charges).
df_correlacion = df[['age','bmi','children','charges']].copy()

matriz_cn = df_correlacion.corr()

#Visualízala con un heatmap.
plt.figure(num="Matriz de Correlacion Numerica")
plt.title("Matriz de Correlacion Numerica")
sns.heatmap(data=matriz_cn, annot=True)
plt.show()
